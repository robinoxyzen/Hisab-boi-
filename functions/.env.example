# Copy to functions/.env before deploy. Firebase loads this for Cloud Functions.
# Bootstrap admin: a verified Google account in this list receives the custom claim admin.
# Change it if this is not the first operator. Do not decide admin from the Android client.
ADMIN_EMAILS=robindotx@gmail.com

# SMS gateway. Leave SMS_API_KEY empty to skip server SMS; the app opens the phone SMS app instead.
SMS_PROVIDER=bulksmsbd
SMS_API_URL=https://bulksmsbd.net/api/smsapi
SMS_API_KEY=
SMS_SENDER_ID=HISABBOI

# Future MFS/bank notice. Disabled by default. This does not move money.
PAYMENT_WEBHOOK_ENABLED=false
PAYMENT_WEBHOOK_SECRET=
