rules_version = '2';
// Images are private to the signed-in owner.
// Verification files are also readable by accounts whose ID token has admin == true.
// KYC files are never readable by admins or other users.
// Nothing in this bucket is a payment instrument. The app does not store card data.

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function imageWrite() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{uid}/profile.jpg {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && imageWrite();
    }

    match /users/{uid}/businesses/{bid}/contacts/{cid}/kyc/{file} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && imageWrite();
    }

    match /users/{uid}/businesses/{bid}/verification/{file} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) && imageWrite();
    }

    match /users/{uid}/{path=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && imageWrite();
    }
  }
}
